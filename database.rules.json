{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && (!data.exists() || data.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && (data.exists() || !newData.exists() || (data.parent().parent().child('status').val() === 'lobby' && !data.parent().parent().child('kicked').child(auth.uid).exists()))",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 9" }
          }
        },
        "chat": {
          "$msg": {
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" }
          }
        }
      }
    }
  }
}
