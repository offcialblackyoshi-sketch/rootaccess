{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && (!data.exists() || data.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && (data.exists() || !newData.exists() || (!data.parent().parent().child('kicked').child(auth.uid).exists() && (data.parent().parent().child('status').val() === 'lobby' || newData.child('spectator').val() === true)))",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 9" }
          }
        },
        "chat": {
          "$msg": {
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        "handle": { ".validate": "newData.isString() && newData.parent().parent().parent().child('handles').child(newData.val().toLowerCase()).val() === $uid" },
        "xp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000" }
      }
    },
    "handles": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "$name.matches(/^[a-z0-9_.-]{2,14}$/)"
      }
    },
    "leaderboards": {
      ".read": "auth != null",
      "daily": {
        "$date": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true && !data.exists() && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            ".validate": "newData.hasChildren(['handle', 'ms', 'hints', 'at']) && newData.child('handle').isString() && newData.child('handle').val().length <= 14 && newData.child('ms').isNumber() && newData.child('ms').val() >= 20000 && newData.child('ms').val() <= 3600000 && newData.child('hints').isNumber() && newData.child('at').val() <= now"
          }
        }
      },
      "xp": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['handle', 'xp']) && newData.child('handle').isString() && newData.child('handle').val().length <= 14 && newData.child('xp').isNumber() && newData.child('xp').val() >= 0"
        }
      }
    }
  }
}
